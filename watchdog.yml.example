# Watchdog daemon configuration example
# Copy to watchdog.yml and edit to match your setup.

router_ip: "192.0.2.1"
password: "YOUR_PASSWORD"

# Network mode (optional): 5G+4G+3G, 5G_NSA, 5G_SA, 4G+5G, 4G+3G, 4G, 3G
# network_mode: "4G"

# LTE band lock (optional): list of band numbers
# lte_bands: [3, 7, 28]

# 5G NR band lock (optional): list of band numbers
# nr5g_bands: [28, 78]

# Cell lock (optional): PCI + EARFCN pair. Requires reboot to apply.
# cell_lock:
#   pci: 123
#   earfcn: 3350

# DNS (optional): manual DNS servers
# dns:
#   primary: "1.1.1.1"
#   secondary: "1.0.0.1"

# Active-band minimums (optional): detect carrier-aggregation drop independently of the lock setting.
# The lock can read correct while the radio is stuck on a single band; these thresholds catch that.
# min_active_lte_bands: 2   # trigger if fewer than this many LTE bands are actually aggregated
# min_active_nr5g_bands: 1  # trigger if fewer than this many NR bands are actually active
